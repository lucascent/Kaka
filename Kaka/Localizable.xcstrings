            "state" : "translated",
            "value" : "Give Kaka access to stitch consecutive screenshots into one long image. Processing happens on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da acceso a Kaka para unir las capturas consecutivas en una sola imagen larga. Todo se procesa en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
