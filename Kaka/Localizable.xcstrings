    "上下拖动，重影消失就对齐了" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag up or down until the double image disappears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra arriba o abajo hasta que desaparezca la imagen doble."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez vers le haut ou le bas jusqu’à ce que l’image ne soit plus dédoublée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二重に見える部分が消えるまで上下にドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "겹쳐 보이는 부분이 사라질 때까지 위아래로 드래그하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下拖曳，直到重影消失"
          }
        }
      }
    },
